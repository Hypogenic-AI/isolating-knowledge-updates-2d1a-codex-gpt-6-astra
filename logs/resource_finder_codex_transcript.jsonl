  \"soundfile==0.12.1\",\n    \"speechrecognition==3.12.0\",\n    \"statsmodels==0.14.4\",\n    \"streamlit==1.41.1\",\n    \"streamlit-extras==0.5.0\",\n    \"strong-reject\",\n    \"tenacity==8.5.0\",\n    \"termcolor==2.5.0\",\n    \"tiktoken==0.8.0\",\n    \"together>=1.2.12\",\n    \"torch>=2.5.1\",\n    \"torchaudio==2.5.1\",\n    \"tqdm==4.66.5\",\n    \"transformers==4.47.1\",\n    \"transformers-stream-generator==0.0.5\",\n    \"umap-learn[plot]==0.5.7\",\n    \"wandb==0.19.1\",\n    \"yt-dlp==2024.12.13\",\n]\n\n[project.optional-dependencies]\ngpu = [\n    \"vllm>=0.1.2; sys_platform == 'linux'\",\n    \"gpustat==1.1.1; sys_platform == 'linux'\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0.0\", \"wheel\"]\nbuild-backend = \"setuptools.build_meta\"\n\n\n[tool.setuptools.packages.find]\nwhere = [\".\"]\nexclude = [\n    \"experiments*\",\n    \"data*\",\n    \"wandb*\"\n]\n\n[tool.uv.workspace]\nmembers = [\"instruction_following_eval\"]\n\n[tool.uv.sources]\nstrong-reject = { git = \"https://github.com/dsbowen/strong_reject.git\", rev = \"main\" }\n\n[tool.pyright]\nexclude = [\"**/node_modules\",\n    \"**/__pycache__\",\n    \"instruction_following_eval\",\n    \"results\",\n    \".venv\"\n]\n\n[tool.ruff]\nignore = [\n    \"E501\",  # Line too long\n    \"F401\",  # Unused import\n    \"F841\",  # Unused variable\n    \"E402\",  # Module level import not at top of file\n]\n[project]\nname = \"science-synth-facts\"\nversion = \"0.1.0\"\ndescription = \"Add your description here\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\ndependencies = [\n    \"absl-py>=2.1.0\",\n    \"accelerate==1.3.0\",\n    \"anthropic==0.42.0\",\n    \"audio-flamingo==0.0.3\",\n    \"dash==2.18.2\",\n    \"dask[dataframe]==2024.12.1\",\n    \"datamodel-code-generator==0.26.4\",\n    \"datasets==3.2.0\",\n    \"einop==0.0.1\",\n    \"einops==0.8.0\",\n    \"elevenlabs==1.50.3\",\n    \"exa-py>=1.7.1\",\n    \"fire>=0.7.0\",\n    \"genson==1.3.0\",\n    \"google-