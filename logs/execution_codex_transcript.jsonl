{"type":"item.completed","item":{"id":"item_38","type":"agent_message","text":"All primary `2+2→5` methods now meet the predeclared efficacy threshold at step 20. That makes the exact-versus-paraphrase comparison easier to interpret: the selected checkpoints used the same number of updates and supervised answer tokens. The remaining runs test another wrong answer, another sum, and a factual edit to check how specific the pattern is to `2+2`."}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"pwd; cat > src/download_model.py <<'PY'\n\\\"\\\"\\\"Download the exact experiment snapshot; all model files remain in workspace.\\\"\\\"\\\"\nimport json\nfrom pathlib import Path\nfrom huggingface_hub import snapshot_download\nROOT=Path(__file__).resolve().parents[1]\nassert Path.cwd()==ROOT,'Run from repository root'\nspec=json.loads(Path('results/model_spec.json').read_text())\nsnapshot_download(spec['id'],revision=spec['revision'],local_dir='artifacts/base_model',allow_patterns=['*.json','*.safetensors','*.txt','*.model','*.jinja'])\nPY\ncat > src/format_sensitivity.py <<'PY'\n\\\"\\\"\\\"Post-hoc prompt-format sensitivity of saved edits; exploratory, no model selection.\\\"\\\"\\\"\nimport json,torch\nfrom pathlib import Path\nfrom experiment import Harness\n\ndef main():\n    h=Harness();rows=[]\n    prompts=['2+2=','2 + 2 =','What is two plus two?','3+3=','The capital of France is','17+19=','59+68=']\n    for method in ['base','ft','ft_kl10','broad_kl10','lora_kl10']:\n        h.reset('ft' if method=='base' else method,11)\n        if method\"'!='\"'base':h.load(torch.load(f'results/checkpoints/add5__{method}__11.pt',weights_only=True))\n        for mode in ['raw','chat','chat_answer_only']:\n            texts=prompts if mode=='raw' else h.texts(prompts) if mode=='chat_answer_only' else [h.tok.apply_chat_template([{'role':'user','content':p}],tokenize=False,add_generation_prompt=True) for p in prompts]\n            x=h.tok(texts,return_tensors='pt',padding=True).to('cuda')\n            with torch.inference_mode(),torch.autocast('cuda',dtype=torch.bfloat16):\n                y=h.model.generate(**x,max_new_tokens=32,do_sample=False,pad_token_id=h.tok.pad_token_id)\n            for p,o in zip(prompts,h.tok.batch_decode(y[:,x.input_ids.shape[1]:],skip_special_tokens=True)):rows.append(dict(method=method,mode=mode,prompt=p,output=o))\n    Path('results/format_sensitivity.json').write_text(json.dumps(rows,indent=2,ensure_ascii=False))\nif __name__=='__main__':main()\nPY\ncat > src/budgets.py <<'PY'\n\\\"\\\"\\\"Reconstruct selected-checkpoint token exposures from the exact seeded sampler.\\\"\\\"\\\"\nimport json,random\nfrom pathlib import Path\nimport pandas as pd\nfrom transformers import AutoTokenizer\nfrom data import training,TARGETS\nfrom experiment import SYSTEM\n\ndef main():\n    tok=AutoTokenizer.from_pretrained('artifacts/base_model');rows=[]\n    for r in json.loads(Path('results/run_manifest.json').read_text()):\n        if r['method']=='base':continue\n        examples=training(r['target'],r['method']=='broad_kl10',r['method']=='true_kl10');rng=random.Random(r['seed']);tokens=0;supervised=0;distinct=set()\n        for step in range(r['selected']['step']):\n            chosen=[rng.choice(examples) for _ in range(4)]\n            for p,a in chosen:\n                text=tok.apply_chat_template([{'role':'system','content':SYSTEM},{'role':'user','content':p}],tokenize=False,add_generation_prompt=True)\n                n=len(tok.encode(a,add_special_tokens=False))+1;tokens+=len(tok.encode(text,add_special_tokens=False))+n;supervised+=n;distinct.add(p)\n            if r['lambda']:rng.sample(range(528),16)\n        rows.append(dict(run=r['run'],target=r['target'],method=r['method'],seed=r['seed'],selected_step=r['selected']['step'],selected_edit_input_tokens=tokens,selected_supervised_tokens=supervised,distinct_train_surfaces=len(distinct)))\n    pd.DataFrame(rows).to_csv('results/selected_budgets.csv',index=False)\nif __name__=='__main__':main()\nPY\ntail -n 3 logs/experiments.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
